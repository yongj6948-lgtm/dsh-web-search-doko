{
  "name": "dsh-web-search-doko",
  "version": "0.1.0",
  "description": "Doko search/read/screenshot providers for DeepSeek Harness (ctx.web + web_screenshot).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/live-smoke.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1",
    "@deepseek-ai/dsh-web": ">=0.0.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-launch-environment": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-web": "^0.0.1-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
